dist
.DS_Store
.env
data/

# Ignore the output video from Git but not videos you import into src/.
out

# Generated media resources (audio, images, videos, backups, manifests) — not code
public/projects/

# Scratch state: service logs, undo/redo media snapshots, deleted-scene media, narration drafts.
# tmp/pdfs holds the tracked reference pages.
tmp/*
!tmp/pdfs/

# Local snapshot of gia-long p1 before the kịch bản rewrite (never committed)
archive/gia-long-p1-before-kichban-20261019-1749/

# Generated from projects/<slug>/scene-plan.md + assets by scripts/build-remotion.mjs
# (npm run dev / build rebuild stale bundles; the review server rebuilds on every plan edit).
src/projects-data/
# Outputs of the legacy measure-audio.mjs / align-captions.mjs (nothing imports them).
src/audio-durations.ts
src/caption-data.ts
# Per-machine state: which project the review server and CLI scripts act on, and where renders go.
projects/active.json
projects/output-dir.json
# Manual scene-plan backups — git history already keeps every committed version.
projects/**/scene-plan.md.*
