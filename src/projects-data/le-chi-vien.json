{
  "slug": "le-chi-vien",
  "title": "Vụ án Lệ Chi Viên",
  "aspect": "16:9",
  "width": 1920,
  "height": 1080,
  "publicPrefix": "projects/le-chi-vien",
  "fps": 30,
  "durationInFrames": 1797,
  "scenes": [
    {
      "scene": 1,
      "narration": "Mùa thu năm một nghìn bốn trăm bốn mươi hai, tại vườn vải Lệ Chi Viên, vua Lê Thái Tông đột ngột băng hà chỉ sau một đêm. Mười hai ngày sau, cả ba họ của một vị khai quốc công thần bị đem ra chém.",
      "image": {
        "kind": "search",
        "characters": [],
        "query": "Đại Việt sử ký toàn thư, Bản kỷ q.11, tờ 55 — 八月四日帝至嘉定縣茘枝園遽得虐疾崩 (đánh dấu)"
      },
      "title": "Đại Việt sử ký toàn thư · 1442",
      "cue": "tense",
      "hasAudio": true
    },
    {
      "scene": 2,
      "narration": "Vị công thần ấy là Nguyễn Trãi, người viết Bình Ngô đại cáo, từng sát cánh bên Lê Lợi đánh đuổi giặc Minh.",
      "image": {
        "kind": "search",
        "characters": [],
        "query": "Chân dung Nguyễn Trãi (tranh thờ)"
      },
      "title": "Nguyễn Trãi (1380 – 1442)",
      "cue": "neutral",
      "hasAudio": true
    },
    {
      "scene": 3,
      "narration": "Về già, ông lui về Côn Sơn ở ẩn. Tháng bảy năm ấy, vị vua trẻ mới hai mươi tuổi đi duyệt quân ở Chí Linh, rồi ghé thăm ông.",
      "image": {
        "kind": "search",
        "characters": [],
        "query": "Đại Việt sử ký toàn thư, Bản kỷ q.11, tờ 55 — 七月二十七日帝東巡閱武於至靈城阮廌邀駕幸廌鄉昆山寺 (đánh dấu)"
      },
      "title": "Toàn thư: vua ghé chùa Côn Sơn",
      "cue": "neutral",
      "hasAudio": true
    },
    {
      "scene": 4,
      "narration": "Theo hầu vua khi ấy là Nguyễn Thị Lộ, người vợ lẽ tài sắc của Nguyễn Trãi. Trên đường về kinh, đoàn xa giá dừng chân ở vườn vải Lệ Chi.",
      "image": {
        "kind": "search",
        "characters": [],
        "query": "Tượng thờ Nguyễn Trãi và Nguyễn Thị Lộ tại đền Lệ Chi Viên"
      },
      "title": "Nguyễn Thị Lộ (tượng thờ)",
      "cue": "curious",
      "hasAudio": true
    },
    {
      "scene": 5,
      "narration": "Đêm ấy, nhà vua thức suốt đêm bên Thị Lộ, rồi băng hà ngay tại vườn vải.",
      "image": {
        "kind": "search",
        "characters": [],
        "query": "Đại Việt sử ký toàn thư, Bản kỷ q.11, tờ 55 — 茘枝園與阮氏路通宵而崩…夜半入宮 (đánh dấu)"
      },
      "title": "Toàn thư: «通宵而崩»",
      "cue": "somber",
      "hasAudio": true
    },
    {
      "scene": 6,
      "narration": "Các quan giấu kín tin dữ, lặng lẽ đưa thi hài vua về kinh thành, đến nửa đêm mới phát tang.",
      "image": {
        "kind": "search",
        "characters": [],
        "query": "Điện Kính Thiên trong thành Hà Nội, ảnh chụp 1884–1885"
      },
      "title": "Điện Kính Thiên · ảnh chụp 1884",
      "cue": "tense",
      "hasAudio": true
    },
    {
      "scene": 7,
      "narration": "Triều đình quy cho Thị Lộ tội giết vua. Người viết nên áng thiên cổ hùng văn, khi ấy đã sáu mươi hai tuổi, bị khép tội tru di tam tộc.",
      "image": {
        "kind": "search",
        "characters": [],
        "query": "Đại Việt sử ký toàn thư, Bản kỷ q.11, tờ 56 — 人皆言阮氏路弑帝 / 殺行遣阮廌并妻阮氏路罪及三族 (đánh dấu)"
      },
      "title": "Toàn thư: «罪及三族»",
      "cue": "somber",
      "hasAudio": true
    },
    {
      "scene": 8,
      "narration": "Phải hai mươi hai năm sau, vua Lê Thánh Tông mới minh oan cho ông, và viết rằng: lòng Ức Trai sáng tựa sao Khuê.",
      "image": {
        "kind": "search",
        "characters": [],
        "query": "Ức Trai tập 抑齋集 (bản Phúc Khê, khoảng 1868)"
      },
      "title": "Ức Trai tập · bản in 1868",
      "cue": "hopeful",
      "hasAudio": true
    },
    {
      "scene": 9,
      "narration": "Còn đêm ấy ở Lệ Chi Viên, điều gì đã thật sự xảy ra, đến nay vẫn là một câu hỏi chưa có lời đáp.",
      "image": {
        "kind": "search",
        "characters": [],
        "query": "Đài Lệ Chi Viên, Đại Lai, Bắc Ninh (ảnh hiện trạng)"
      },
      "title": "Lệ Chi Viên hôm nay",
      "cue": "curious",
      "hasAudio": true
    }
  ],
