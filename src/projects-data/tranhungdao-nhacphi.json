      "hasAudio": true
    },
    {
      "scene": 7,
      "narration": "Nhạc Phi trung thành với Nam Tống nhưng cuối cùng bị Tần Cối hãm hại và xử tử năm 1142, dù công lao chống quân Kim rất lớn.",
      "image": {
