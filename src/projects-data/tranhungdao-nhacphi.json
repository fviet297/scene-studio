    {
      "scene": 2,
      "narration": "Trần Hưng Đạo, tên thật là Trần Quốc Tuấn, sinh khoảng năm 1228 dưới thời nhà Trần.",
      "image": {
        "kind": "ai",
        "characters": [
          "char-a"
        ],
        "identity": "full",
        "prompt": "A child stands in a sunlit courtyard, symbolizing early life. Setting: mid-13th-century Đại Việt, Trần dynasty. Background shows a modest timber house with a steep thatched roof and woven bamboo walls, surrounded by banana palms and a low brick garden wall. Two villagers in plain 13th-century Vietnamese peasant dress, with East-Asian faces, work nearby. No Qing, Ming, or Nguyễn-dynasty costume, no Chinese or European buildings.",
        "motion": "",
        "promptVi": "",
        "motionVi": ""
      },
      "hasAudio": true
    },
    {
      "scene": 3,
      "narration": "Nhạc Phi sinh năm 1103 dưới thời Nam Tống, từ một người lính trở thành danh tướng chống quân Kim.",
      "image": {
        "kind": "ai",
        "characters": [
          "char-b"
        ],
        "identity": "full",
        "prompt": "Marching at the head of a Song dynasty column on a dusty rural road, the main character leads with upright bearing as ordinary Southern Song soldiers with East-Asian faces follow in early-12th-century lamellar armour, plain conical helmets, and round shields. Overhead, a battered black Song banner flutters. Background: modest grey-tiled Song farmhouses and bamboo groves. No Ming or Qing dress, no Đại Việt architecture, no European elements.",
        "motion": "",
        "promptVi": "",
        "motionVi": ""
      },
      "hasAudio": true
    },
    {
      "scene": 4,
      "narration": "Trần Hưng Đạo nổi bật với ba lần chỉ huy quân Đại Việt chống quân Mông Nguyên, đặc biệt là chiến thắng Bạch Đằng năm 1288.",
      "image": {
        "kind": "ai",
        "characters": [
          "char-a"
        ],
        "identity": "full",
        "prompt": "Commanding from the riverbank during the 1288 Battle of Bạch Đằng, gesturing toward Đại Việt warships and bamboo stakes emerging at low tide as Mongol Yuan ships approach. Setting: late-13th-century Đại Việt, muddy riverside with dense mangroves and distant limestone hills. Background soldiers with East-Asian faces wear late-Trần dynasty lamellar armour, rattan shields, spears. No Qing or Ming dress, no Chinese or European ships.",
        "motion": "",
        "promptVi": "",
        "motionVi": ""
      },
      "motionVideo": true,
      "hasAudio": true
    },
    {
      "scene": 5,
      "narration": "Nhạc Phi cũng lập nhiều chiến công trước quân Kim, xây dựng Nhạc gia quân nổi tiếng với kỷ luật và sức chiến đấu.",
      "image": {
        "kind": "ai",
        "characters": [
          "char-b"
        ],
        "identity": "full",
        "prompt": "Leading disciplined Song-Yue forces in battle against Jurchen Jin, standing at the front as ranks of Song soldiers in early-12th-century Chinese lamellar armor advance with upright spears and Song banners, officers shouting orders. Setting: a misty open plain with churned earth and distant Song war drums, low Song military tents in the background. All soldiers have East-Asian faces. No Ming or Qing dress, no Vietnamese or European elements.",
        "motion": "",
        "promptVi": "",
        "motionVi": ""
      },
      "hasAudio": true
    },
    {
      "scene": 6,
      "narration": "Trần Hưng Đạo không chỉ giỏi cầm quân mà còn nổi tiếng với tư tưởng quân sự, thể hiện qua Hịch tướng sĩ.",
      "image": {
        "kind": "ai",
        "characters": [
          "char-a"
        ],
        "identity": "full",
        "prompt": "Standing at a low wooden desk in a 13th-century Trần-dynasty Vietnamese military tent, the main character unfurls a scroll and gestures thoughtfully, surrounded by early Trần Vietnamese officers in plain lacquered helmets and quilted lamellar armour, all with East-Asian faces. Background shows fluttering triangular red silk banners and a bamboo palisade outside. Warm daylight filters in. No Ming or Qing armour, no Song Chinese setting, no European elements.",
        "motion": "",
