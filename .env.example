# Replicate image + motion-video generation (review server's "Image to video" model picker
# posts the chosen model id per request; REPLICATE_API_TOKEN is the only var required here)
REPLICATE_API_TOKEN=
# Scene image models, routed by reference count in scripts/lib/replicate-image.mjs (all optional):
#   SINGLE = one character reference → cheap FLUX Kontext dev
#   MULTI  = two+ references → Seedream 4.5 (keeps a distinct face per person)
#   TEXT   = no reference → cheap FLUX dev text-to-image
# REPLICATE_SINGLE_MODEL=black-forest-labs/flux-kontext-dev
# REPLICATE_MULTI_MODEL=bytedance/seedream-4.5
# REPLICATE_TEXT_MODEL=black-forest-labs/flux-dev
# Character restyle reference model (scripts/restyle-characters.mjs) — kept on Seedream:
# REPLICATE_KONTEXT_MODEL=bytedance/seedream-4.5

# OpenAI scene-prompt generation (writes prompt: from narration — review server's
# "Generate prompt from narration" button and scripts/generate-prompts.mjs)
OPENAI_API_KEY=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
# OPENAI_PROMPT_MODEL=gpt-4.1

# VMedia image-to-video (review server; one of the model choices in "Image to video")
VMEDIA_API_KEY=
VMEDIA_VIDEO_MODEL=wan_2_5
VMEDIA_VIDEO_MODE=relax
VMEDIA_DOMAIN=vmedia.ai
VMEDIA_PROJECT_ID=default
VMEDIA_VIDEO_RATIO=9:16
VMEDIA_VIDEO_RESOLUTION=720p
VMEDIA_VIDEO_DURATION=5
