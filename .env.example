# The review panel's "Model" button edits provider endpoints / API keys and the model lists
# (including extra OpenAI Images-compatible providers) into data/models.json, which takes priority
# over the values below; clearing a value there falls back to .env.

# Replicate image + motion-video generation (review server's "Image to video" model picker
# posts the chosen model id per request; REPLICATE_API_TOKEN is the only var required here)
REPLICATE_API_TOKEN=
# Scene image models, routed by reference count in scripts/lib/replicate-image.mjs (all optional):
#   SINGLE = one character reference → cheap FLUX Kontext dev
#   MULTI  = two+ references → Seedream 4.5 (keeps a distinct face per person)
#   TEXT   = no reference → cheap FLUX dev text-to-image
# REPLICATE_SINGLE_MODEL=black-forest-labs/flux-kontext-dev
# REPLICATE_MULTI_MODEL=bytedance/seedream-4.5
# REPLICATE_TEXT_MODEL=black-forest-labs/flux-dev
# Character restyle reference model (scripts/restyle-characters.mjs) — kept on Seedream:
# REPLICATE_KONTEXT_MODEL=bytedance/seedream-4.5

# Plenx AI (plenxai.com) motion-video only. The "Image to video" picker lists plenx:omni-flash-video and
# plenx:flux-3 (image-to-video, 720p by default); more models can be added in the panel's Model manager.
# PLENX_API_KEY = the pk_ key from your Plenx account. Scene images are uploaded to Plenx first.
PLENX_API_KEY=
# PLENX_BASE_URL=https://plenxai.com
# PLENX_VIDEO_RESOLUTION=720p

# Meta Model API (api.meta.ai) image only — muse-image-1.0, ~$0.01/img, accepts multiple references.
# The "Image" picker lists meta:muse-image-1.0. No video model exists there, so no motion entry.
MODEL_API_KEY=
# META_BASE_URL=https://api.meta.ai/v1

# OpenAI scene-prompt generation (writes prompt: from narration — review server's
# "Generate prompt from narration" button and scripts/generate-prompts.mjs)
OPENAI_API_KEY=
# OPENAI_PROMPT_MODEL=gpt-4.1

# Script generator LLM — any OpenAI-compatible chat/completions endpoint (review panel
# "Dự án mới → Từ yêu cầu (AI)": narration + image prompt + motion prompt for a whole video).
# LLM_USER_AGENT is optional (some routers only accept known client user agents).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_USER_AGENT=

# muse2api (self-hosted museapivn server wrapping muse.ai). The "Image" picker lists muse:muse-image
# (single reference). muse:muse-video (5/6/8/10s) is not listed — muse.ai refuses video by region —
# but still works by typing it into the motion dialog's custom-model field.
# MUSE2API_KEY = the server's m2a_ key (its .env MUSE2API_KEY, or admin panel → API key).
MUSE2API_BASE_URL=http://localhost:18610
MUSE2API_KEY=
